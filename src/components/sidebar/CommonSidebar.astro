---
import { getCollection } from "astro:content";

import { SITE, MENU, SIDEBAR } from "../../utils/config";
import { __ } from "../../utils/i18n";
import SocialList from "../sidebar/SocialList.astro";
import { urlFor } from "../../utils/urlFor";

async function getStats() {
  const posts = await getCollection("blog");
  const allTags = new Set<string>();
  posts.forEach((post) => {
    post.data.tags?.forEach((tag: string) => allTags.add(tag));
  });
  return {
    postCount: posts.length,
    tagCount: allTags.size,
  };
}

const stats = await getStats();

const currentPath = Astro.url.pathname;
const normalizedPath = currentPath.endsWith('/') && currentPath.length > 1 
  ? currentPath.slice(0, -1) 
  : currentPath;
---

<div class="sidebar-author">
  <img loading="lazy" src={urlFor(SIDEBAR.avatar)} alt={SITE.author} />
  <div class="sidebar-author-name">{SITE.author}</div>
  <div class="sidebar-description">{SITE.description}</div>
</div>

<div class="sidebar-state">
  <div class="sidebar-state-article">
    <div class="sidebar-state-number">{stats.postCount}</div>
    <div>{__("sidebar.post")}</div>
  </div>
  <div class="sidebar-state-tag">
    <div class="sidebar-state-number">{stats.tagCount}</div>
    <div>{__("sidebar.tag")}</div>
  </div>
</div>

<SocialList />

<div class="sidebar-menu">
  {
    MENU.map((item) => {
      const itemUrl = urlFor(item.url);
      const normalizedItemUrl = itemUrl.endsWith('/') && itemUrl.length > 1 
        ? itemUrl.slice(0, -1) 
        : itemUrl;
      const isActive = normalizedPath === normalizedItemUrl;
      return (
        <div class={`sidebar-menu-link-wrap ${isActive ? "link-active" : ""}`}>
          <a class="sidebar-menu-link-dummy" href={itemUrl} />
          <div class="sidebar-menu-inner">
            <div class="sidebar-menu-icon">
              <img src={urlFor("/images/taichi.png")} alt="" aria-hidden="true" width={24} height={24} />
            </div>
            <div class="sidebar-menu-link">{__(item.name)}</div>
          </div>
        </div>
      );
    })
  }
</div>

<style lang="stylus">
  .sidebar-author {
    display: flex;
    flex-shrink: 0;
    flex-direction: column;
    align-items: center;

    img {
      display: block;
      min-width: 100px;
      min-height: 100px;
      width: 100px;
      height: 100px;
      border-radius: 50%;
      transition: opacity 0.3s;
      object-fit: cover;
      margin: 20px;
      box-shadow: 0 0 15px 5px var(--color-red-6-shadow);
      will-change: transform;
      transition: 0.3s;

      &:hover {
        transform: scale(1.05);
      }
    }

    .sidebar-author-name {
      font-weight: bold;
      font-size: 20px;
      color: var(--red-2);
      margin: 12px;
    }

    .sidebar-description {
      color: var(--grey-7);
      margin: 0 20px;
      line-height: 1.2;
    }
  }

  .sidebar-state {
    display: flex;
    justify-content: center;
    padding: 24px 0;
    color: var(--red-0);
    opacity: 0.8;
    transition: opacity 0.5s, color 0.5s;

    &:hover {
      opacity: 1;
    }

     div {
      display: flex;
      flex-direction: column;
      flex-shrink: 0;
      align-items: center;
      padding: 0 20px;

      div {
        margin: 4px 0;
      }
    }
  }

  .sidebar-state-article {
    border-right: 1px solid var(--red-1);
  }

  .sidebar-state-tag {
    border-left: 1px solid var(--red-1);
  }

  .sidebar-state-number {
    font-weight: bold;
    font-size: 20px;
  }

  .sidebar-menu {
    margin: 20px 0;
    width: 100%;
  }

  // ===== 左侧菜单霓虹发光按钮（渐变描边 + hover 发光 + 深底白字） =====
  .sidebar-menu-link-wrap {
    // 主题反色变量：light = 白配色（浅底深字），dark = 黑配色（深底白字）
    --nm-bg: #ffffff; // 内层背景（浅色主题）
    --nm-bg-active: #f0f0f0; // 当前页内层背景（浅色主题）
    --nm-text: #444444; // 文字/图标颜色（浅色主题）
    --nm-border: #e8e8e8; // 内层边框（浅色主题）

    position: relative;
    width: 70%;
    max-width: 200px;
    height: 44px;
    margin: 8px auto;
    background: #fff; // 渐变伪元素默认藏在这层白底下

    // 渐变边框（::before 实边 + ::after 发光模糊层）
    &::before,
    &::after {
      content: '';
      position: absolute;
      // 兜底渐变：菜单超过 3 项时 nth-child(4+) 仍保持霓虹效果（避免纯红底）
      background: linear-gradient(45deg, #00ccff, #0e1538, #0e1538, #d400d4);
      transition: 0.5s;
    }

    // hover 或当前页（link-active）：展开描边与发光
    &:hover::before,
    &.link-active::before {
      inset: -3px;
    }
    &:hover::after,
    &.link-active::after {
      inset: -3px;
      filter: blur(10px);
    }

    // 三个菜单循环使用两套渐变（蓝紫 / 红绿）
    &:nth-child(1)::before,
    &:nth-child(1)::after {
      background: linear-gradient(45deg, #00ccff, #0e1538, #0e1538, #d400d4);
    }
    &:nth-child(2)::before,
    &:nth-child(2)::after {
      background: linear-gradient(45deg, #ff075b, #0e1538, #0e1538, #1aff22);
    }
    &:nth-child(3)::before,
    &:nth-child(3)::after {
      background: linear-gradient(45deg, #00ccff, #0e1538, #0e1538, #d400d4);
    }
  }

  // 暗色主题反色：黑配色（深底白字），边缘发光渐变不受影响
  :global([data-theme='dark']) .sidebar-menu-link-wrap {
    --nm-bg: #0e1538; // 内层背景（深蓝黑底，原霓虹风格）
    --nm-bg-active: #16204f; // 当前页内层背景
    --nm-text: #ffffff; // 文字/图标颜色
    --nm-border: #040a29; // 内层边框
  }

  // 内层深底面板：盖在渐变之上，承载图标与文字（颜色由主题变量控制，随明暗反色）
  .sidebar-menu-inner {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: var(--nm-bg); // 主题反色：light 白底 / dark 深蓝黑底
    z-index: 10;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--nm-border); // 主题反色边框
    overflow: hidden;
    pointer-events: none; // 让点击穿透到 dummy 链接
    // 锐角切角：左上角斜切 12px，露出下方霓虹渐变；
    // 发光/描边在外壳（.sidebar-menu-link-wrap 的 ::before/::after）上，不受切角影响
    clip-path: polygon(12px 0, 100% 0, 100% 100%, 0 100%, 0 12px);

    // 左上角斜纹高光
    &::before {
      content: '';
      position: absolute;
      top: 0;
      left: -50%;
      width: 100%;
      height: 100%;
      background: rgba(255, 255, 255, 0.075);
      transform: skew(25deg);
    }
  }

  .sidebar-menu-icon {
    color: var(--nm-text); // 主题反色文字
    opacity: 0.9;
    display: flex;
    padding: 5px;
    align-items: center;
    pointer-events: none;
    transition: transform 0.3s, opacity 0.3s;
    transform: rotate(90deg); // 保留原阴阳图标旋转样式

    .sidebar-menu-link-wrap:hover & {
      transform: rotate(90deg) scale(1.1); // 保留原 hover 旋转交互
      opacity: 1;
    }
  }

  .sidebar-menu-link-dummy {
    position: absolute;
    width: 100%;
    height: 100%;
    top: 0;
    left: 0;
    z-index: 20; // 盖在内层之上，保证可点击
  }

  .sidebar-menu-link {
    color: var(--nm-text); // 主题反色文字
    opacity: 0.9;
    text-decoration: none;
    display: block;
    padding: 10px 15px;
    font-weight: 700;
    pointer-events: none;
    transition: opacity 0.2s;
  }

  // 当前页高亮：渐变常驻展开 + 内层微亮（随主题反色）
  .link-active {
    .sidebar-menu-inner {
      background: var(--nm-bg-active); // 主题反色：light 浅灰 / dark 微亮深蓝
    }

    .sidebar-menu-link,
    .sidebar-menu-icon {
      opacity: 1;
    }
  }
</style>
