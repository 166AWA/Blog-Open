---
// FriendLinkCard.astro — 友链卡片（美观版）
// 数据源: src/config.ts 的 friend 数组 (name/url/desc/avatar)
import { FRIEND } from "../../utils/config";

const links = FRIEND;
---

<div class="friend-grid" data-aos="fade-up">
  {
    links.map(({ name, desc, url, avatar }, i) => {
      return (
        <a
          class="friend-card"
          href={url}
          target="_blank"
          rel="noopener nofollow noreferrer"
          style={`animation-delay: ${i * 60}ms`}
        >
          <span class="friend-card-inner">
            <span class="friend-avatar">
              <img src={avatar} alt={name} class="no-lightbox" loading="lazy" />
            </span>
            <span class="friend-body">
              <span class="friend-name">{name}</span>
              <span class="friend-desc">{desc}</span>
            </span>
            <span class="friend-arrow" aria-hidden="true">→</span>
          </span>
        </a>
      );
    })
  }
</div>

<style lang="stylus">
  .friend-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: 16px;
    padding: 4px 0 16px;
  }

  .friend-card {
    position: relative;
    display: block;
    text-decoration: none;
    color: var(--color-default);
    border-radius: 16px;
    padding: 14px;
    background: var(--color-wrap);
    border: 1px solid var(--color-border);
    box-shadow: var(--shadow-card);
    transition:
      transform 0.25s ease,
      box-shadow 0.25s ease,
      border-color 0.25s ease;
    animation: friendPop 0.4s ease backwards;
  }

  @keyframes friendPop {
    from {
      opacity: 0;
      transform: translateY(12px) scale(0.98);
    }
    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }

  .friend-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 28px rgb(0 0 0 / 0.18);
    border-color: var(--red-1);
  }

  .friend-card-inner {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .friend-avatar {
    flex-shrink: 0;
    width: 56px;
    height: 56px;
    border-radius: 14px;
    overflow: hidden;
    background: var(--color-header-background);
    box-shadow: inset 0 0 0 1px var(--color-border);
  }

  .friend-avatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .friend-body {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 3px;
  }

  .friend-name {
    font-size: 16px;
    font-weight: 700;
    color: var(--red-1);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .friend-desc {
    font-size: 13px;
    line-height: 1.45;
    color: var(--grey-9, #888);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .friend-arrow {
    flex-shrink: 0;
    font-size: 15px;
    color: var(--grey-9, #888);
    opacity: 0;
    transform: translateX(-6px);
    transition:
      opacity 0.25s,
      transform 0.25s;
  }

  .friend-card:hover .friend-arrow {
    opacity: 1;
    transform: translateX(0);
  }

  @media screen and (max-width: 767px) {
    .friend-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
